{
  "name": "botfacts",
  "version": "1.0.0",
  "private": true,
  "description": "Facts about a token on BOT Chain, with on-chain snapshots. No scores, no verdicts.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network botTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network botMainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "^4.2.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.19"
  }
}
